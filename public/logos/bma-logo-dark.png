<style type="text/css">
body {
    color: #4a4e57;
    font-size: 20px;
    font-family: Montserrat;
    font-weight: 400;
    font-style: normal;
    text-transform: none;
    line-height: 1.6em;
    letter-spacing: 0;
}
h1 {
    color: #333333;
    font-size: 48px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
h2 {
    color: #333333;
    font-size: 30px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
h3 {
    color: #333333;
    font-size: 24px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
h4 {
    color: #333333;
    font-size: 22px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
h5 {
    color: #333333;
    font-size: 22px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
h6 {
    color: #333333;
    font-size: 20px;
    font-family: Montserrat;
    font-weight: 800;
    font-style: normal;
    text-transform: none;
    line-height: 1.2em;
    letter-spacing: 0; 
}
.bma_container {
    width: 1140px;
}
.bma_main_content {
    padding-top: 0px;
    padding-bottom: 0px;
}
.bma_main_header {
    background: rgb(0 0 0 / 100%);
}
.bma_desktop_menu_position_left .bma_header_menu {
    text-align: left;
}
.bma_desktop_menu_position_center .bma_header_menu {
    text-align: center;
}
.bma_desktop_menu_position_right .bma_header_menu {
    text-align: right;
}
.bma_main_header.bma_sticky_header {
     background: rgb(0 0 0 / 90%);
}
.bma_sticky_header .bma_header_menu ul.menu > li > a,
.bma_sticky_header .bma_header_left_menu ul.menu > li > a,
.bma_sticky_header .bma_header_right_menu ul.menu > li > a {
    line-height: 60px;
}
header.bma_header_full_screen_style .bma_header_menu .menu-main-menu-container {
    display: none;
}
header.bma_header_full_screen_style .bma_header_mobile_menu {
    display: block;
    line-height: 120px;
}
.bma_header_mobile_menu_target {
    background-color: #1c1c1c;
}
.bma_header_mobile_menu_target .menu > li > a {
    text-decoration: none;
    font-size: 16px !important;
    color: #ffffff;
    font-family: Montserrat;
    font-weight: 500;
    font-style: normal;
    text-transform: none;
    line-height: 1.6em;
    letter-spacing: 0; 
    padding: 18px 30px;
    display: inline-block;
    background: transparent !important;
}
.bma_header_mobile_menu_target .menu > li > a:hover {
    color: #ff007a;
}
.bma_header_mobile_menu_target .menu > li.current-menu-item > a {
    color: #ff007a;
}

.bma_footer_top,
#menu-footer-left-menu > li > a,
#menu-footer-right-menu > li > a {
    color: #bababa;
    font-size: 20px;
    font-family: Montserrat;
    font-weight: 400;
    font-style: normal;
    text-transform: none;
    line-height: 1.6em;
    letter-spacing: 0; 
}
.bma_footer_top a:hover,
#menu-footer-left-menu > li > a:hover,
#menu-footer-right-menu > li > a:hover {
    color: #ff007a;
}

.bma_footer_copyright_wrap, 
.bma_footer_copyright_wrap a {
    color: #adadad;
    font-size: 12px;
    font-family: Montserrat;
    font-weight: 400;
    font-style: normal;
    text-transform: none;
    line-height: 1.6em;
    letter-spacing: 0; 
}
.bma_footer_copyright_wrap a:hover {
    color: #ff007a;
}

.bma_footer_top {
    background: #000000;
}
.bma_footer_bottom {
    background-color: #212121;
}
.bma_footer_top_inner {
    padding: 60px 0 40px;
}
.bma_footer_bottom_inner {
    padding-top: 20px;
    padding-bottom: 20px;
}


@media only screen and (min-width: 1101px ) {
    .bma_main_header.bma_sticky_header {
      position:fixed;
      -webkit-animation: sticky-header 0.7s;
      -moz-animation: sticky-header 0.7s;
      animation: sticky-header 0.7s;
      width: 100%;
      top: 0;
    }
    @-webkit-keyframes sticky-header { 
      0% { 
        opacity:0; 
        transform:translateY(-100%);
      }
      100% { 
        opacity:0.9; 
        transform:translateY(0);
      }
    }
    @-moz-keyframes sticky-header { 
      0% { 
        opacity:0; 
        transform:translateY(-100%);
      }
      100% { 
        opacity:0.9; 
        transform:translateY(0);
      }
    }
    @keyframes sticky-header { 
      0% { 
        opacity:0; 
        transform:translateY(-100%);
      }
      100% { 
        opacity:0.9; 
        transform:translateY(0);
      }
    }
    .bma_main_header.bma_transparent_header:not(.bma_sticky_header) {
        background: transparent !important;
    }
    .bma_main_header.bma_transparent_header + .bma_sticky_header_fallback_heigh {
        height: 0 !important;
        min-height: 0 !important;
    }
    .admin-bar .bma_main_header {
        top: 32px;
    }
     .bma_header_center_style .bma_header_menu {
         display: none;
     }
     .bma_header_center_style .bma_header_left_menu, 
     .bma_header_center_style .bma_header_right_menu {
         width: calc(50% - 90px);
         text-align: center;
     }
     .bma_header_menu ul.menu > li {
         display: inline-block;
         padding-right: 40px;
     }
     .bma_header_left_menu ul.menu > li,
     .bma_header_right_menu ul.menu > li {
         display: inline-block;
         padding-left: 20px;
         padding-right: 20px;
     }
     .bma_header_menu ul.menu > li > a,
     .bma_header_left_menu ul.menu > li > a,
     .bma_header_right_menu ul.menu > li > a {
         color: #ffffff;
         text-decoration: none !important;
         font-family: Montserrat;
         font-size: 17px;
         line-height: 120px;
         font-weight: 500;
         font-style: normal;
         text-transform: none;
         letter-spacing: ;
         display: inline-block;
         border-top: 3px solid transparent;
         border-bottom: 3px solid transparent !important;
     }
     header:not(.bma_desktop_menu_position_center) .bma_header_menu ul.menu > li:last-child {
         padding-right: 0;
     }
     .bma_header_menu ul.menu > li > a:hover,
     .bma_header_left_menu ul.menu > li > a:hover,
     .bma_header_right_menu ul.menu > li > a:hover {
         border-top-color: #ff007a;
         color: #ff007a;
     }
     .bma_header_menu ul.menu > li.current-menu-item > a,
     .bma_header_left_menu ul.menu > li.current-menu-item > a,
     .bma_header_right_menu ul.menu > li.current-menu-item > a {
         border-top-color: #ff007a;
         color: #ff007a;
     }
     .bma_header_medium_style:not(.bma_sticky_header) .bma_header_menu {
         width: 100%;
         padding-left: 0;
         border-top: 1px solid rgb(255 255 255 / 25%);
     }
     .bma_header_medium_style:not(.bma_sticky_header) .bma_main_header_inner {
         flex-flow: row wrap;
         justify-content: center;
     }
     .bma_header_medium_style:not(.bma_sticky_header) .bma_header_logo {
         padding-top: 20px;
         padding-bottom: 20px;
     }
     .bma_main_header_inner ul.menu .sub-menu {
         position: absolute;
         background: #000000;
         list-style: none;
         text-align: center;
         margin: 0;
         padding: 0;
         width: 240px;
         left: calc(50% - 20px);
         transform: translateX(-50%);
         border-radius: 10px;
         box-shadow: 0 10px 30px rgb(0 0 0 / 25%);
         transition: all .3s ease-in-out .0s;
         opacity: 0;
         visibility: hidden;
     }
     .bma_main_header_inner ul.menu .menu-item-has-children:hover > .sub-menu {
         opacity: 1;
         visibility: visible;
     }
     .bma_main_header_inner ul.menu .sub-menu li + li {
         border-top: 1px solid rgb(255 255 255 / 15%);
     }
     .bma_main_header_inner ul.menu .sub-menu a {
         display: block;
         font-size: 16px;
         padding: 8px 15px;
         color: #ffffff;
         transition: all .3s ease-in-out .0s;
     }
     .bma_main_header_inner ul.menu .sub-menu a:hover {
         color: #ff007a;
     }
     .bma_main_header_inner ul.menu .sub-menu .current-menu-item > a {
         color: #ff007a;
     }
	.hp_banner_section.thrv-page-section .tve-page-section-out {
		height: calc(100vh - 64px) !important;
	}
	.hp_banner_section.thrv-page-section .tve-page-section-out + .tve-page-section-in {
		min-height: calc(100vh - 64px) !important;
	}
}


@media only screen and (max-width: 1100px ) {
     .bma_main_header {
        position: relative !important;
        background: #000 !important;
     }
     .bma_sticky_header_fallback_heigh {
        display: none !important;
     }
     .bma_sticky_header .bma_main_logo_img {
        display: inline-block;
     }
     .bma_sticky_header .bma_sticky_logo_img {
        display: none;
     }
     .bma_header_mobile_menu {
        display: block;
        line-height: 100px;
     }
     .bma_header_menu .menu-main-menu-container {
        display: none;
     }
     .bma_header_left_menu, 
     .bma_header_right_menu {
         display: none !important;
     }
     .bma_main_header_inner ul.menu .sub-menu {
         padding: 0;
         margin: 0;
     }
     .bma_header_mobile_menu_target .menu .sub-menu {
         margin: -10px 0 5px;
         padding: 0;
     }
     .bma_header_mobile_menu_target .menu .sub-menu a {
         color: #ffffff;
         font-size: 16px;
         transition: all .3s ease-in-out .0s;
     }
     .bma_header_mobile_menu_target .menu .sub-menu a:hover {
         color: #ff007a;
     }
     .bma_header_mobile_menu_target .menu .sub-menu .current-menu-item > a {
         color: #ff007a;
     }
     .bma_header_mobile_menu_target .menu .sub-menu a::before {
         content: "- ";
     }
     .bma_header_mobile_menu_target .menu .sub-menu a::after {
         content: " -";
     }
}


