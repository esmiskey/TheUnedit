/** Start Template Kit CSS: Internet Company (css/customizer.css) **/

/* Envato Custom css - applied to the advanced tab of the element it affects */
.envato-kit-200-progress .elementor-progress-wrapper,
.envato-kit-200-progress .elementor-progress-bar{
	border-radius: 30px;
}

/** End Template Kit CSS: Internet Company (css/customizer.css) **/

/* Related Posts: uniform boxes with images filling the container */
.bma_related_post_section {
  margin-top: 60px;
  width: 100%;
}

.bma_related_post_wrap {
  display: flex;
  flex-wrap: nowrap; /* one line only */
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  align-items: stretch;
}

/* Each card box */
.bma_related_post_item {
  flex: 1 1 0;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  height: 220px; /* box height — adjust as needed */
}

.bma_related_post_item:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 16px rgba(0,0,0,0.12);
}

/* Make the image behave like a background cover */
.bma_related_post_item .bma_related_post_item_inner {
  position: absolute;
  inset: 0; /* top:0, right:0, bottom:0, left:0 */
}

.bma_related_post_item img {
  width: 100%;
  height: 100%;
  object-fit: cover;     /* fills box without stretching */
  object-position: center; /* keeps image centered */
  display: block;
  border-radius: 0;
}

/* Optional: make it responsive */
@media (max-width: 1024px) {
  .bma_related_post_wrap {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .bma_related_post_item {
    flex: 0 0 320px; /* fixed box width on scrollable view */
  }

}


		</style>
		</head>
