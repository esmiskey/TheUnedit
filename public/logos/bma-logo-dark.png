     /*----------- Sticky Header Start ------------*/

     // Custom Sticky Header 
     jQuery(window).scroll(function() {    
         var height = jQuery(window).scrollTop(); 
         if(height  > 100) {
             jQuery(".bma_main_header").addClass('bma_sticky_header');
         } else{
             jQuery(".bma_main_header").removeClass('bma_sticky_header');
         }
     });
     // Fallback
     jQuery(window).on('load resize', function() {
         var getHeaderHight = jQuery(".bma_main_header").height();
         jQuery('.bma_sticky_header_fallback_heigh').css({
          'height': getHeaderHight,
          'min-height': getHeaderHight
         });
     });

     /*----------- Sticky Header End ------------*/


     /*----------- Header Mobile Menu Start ------------*/

     jQuery('.bma_main_header:not(.bma_header_full_screen_style) .bma_header_mobile_menu_trigger').click(function(){
          jQuery('.bma_header_mobile_menu_target').slideToggle('slow');
     });

     jQuery('.bma_main_header.bma_header_full_screen_style .bma_header_mobile_menu_trigger').click(function(){
          jQuery('.bma_header_mobile_menu_target').fadeIn('slow');
     });
     jQuery('.bma_header_mobile_menu_close').click(function(){
          jQuery('.bma_header_mobile_menu_target').fadeOut('slow');
     });

     /*----------- Header Mobile Menu End ------------*/


     /*----------- Back To Top Start ------------*/

     var back_to_top_btn = jQuery('.bma_back_to_top');
     jQuery(window).scroll(function() {
       if (jQuery(window).scrollTop() > 300) {
         back_to_top_btn.addClass('show');
       } else {
         back_to_top_btn.removeClass('show');
       }
     });

     back_to_top_btn.on('click', function(e) {
       e.preventDefault();
       jQuery('html, body').animate({scrollTop:0}, '300');
     });

     /*----------- Back To Top End ------------*/


     /*----------- Smooth Scroll Start ------------*/

     jQuery(function() {
       jQuery('a[href*=#]:not([href=#])').click(function() {
         if (location.pathname.replace(/^\//,'') == this.pathname.replace(/^\//,'') && location.hostname == this.hostname) {
           var target = jQuery(this.hash);
           target = target.length ? target : jQuery('[name=' + this.hash.slice(1) +']');
           if (target.length) {
             jQuery('html,body').animate({
               scrollTop: target.offset().top
             }, 2000);
             return false;
           }
         }
       });
     });

     /*----------- Smooth Scroll End ------------*/
</script>




